<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#0B3B66</Color>
    <Color x:Key="PrimaryDark">#8DBBEA</Color>
    <Color x:Key="PrimaryDarkText">#0F1B2D</Color>
    <Color x:Key="Secondary">#E3ECF6</Color>
    <Color x:Key="SecondaryDarkText">#8DBBEA</Color>
    <Color x:Key="Tertiary">#14507F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#B42318</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#0E1621</Color>

    <!-- Paleta Bre-B: azul tinta (confianza), verde (éxito), ámbar (en proceso), rojo (error) -->
    <Color x:Key="Fondo">#F4F6F9</Color>
    <Color x:Key="FondoDark">#0E1621</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="SuperficieDark">#162232</Color>
    <Color x:Key="Borde">#D5DCE5</Color>
    <Color x:Key="BordeDark">#2A3B50</Color>
    <Color x:Key="Texto">#0F1B2D</Color>
    <Color x:Key="TextoDark">#E8EEF5</Color>
    <Color x:Key="TextoSuave">#55657A</Color>
    <Color x:Key="TextoSuaveDark">#9FB0C4</Color>
    <Color x:Key="Exito">#0F7B5F</Color>
    <Color x:Key="ExitoSuave">#E1F4EC</Color>
    <Color x:Key="ExitoSuaveDark">#12362D</Color>
    <Color x:Key="Alerta">#9A4A06</Color>
    <Color x:Key="AlertaSuave">#FDF0DC</Color>
    <Color x:Key="AlertaSuaveDark">#3A2A12</Color>
    <Color x:Key="Peligro">#B42318</Color>
    <Color x:Key="PeligroSuave">#FDEAE8</Color>
    <Color x:Key="PeligroSuaveDark">#3C1A18</Color>
    <Color x:Key="InfoSuave">#E3ECF6</Color>
    <Color x:Key="InfoSuaveDark">#17314A</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>