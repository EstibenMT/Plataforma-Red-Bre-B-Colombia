<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Breb.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Breb.App.Views"
    FlyoutBehavior="Disabled"
    Title="Bre-B">

    <ShellContent
        Title="Ingreso"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Saldo"
        ContentTemplate="{DataTemplate views:SaldoPage}"
        Route="saldo" />

        <ShellContent
            Title="Transferir"
            ContentTemplate="{DataTemplate local:TransferenciaPage}"
            Route="TransferenciaPage" />
    </TabBar>

</Shell>
